# Copy to .env on the server. Never commit the populated file.
SIGNING_DOMAIN=sign.example.com
POSTGRES_PASSWORD=replace-with-random-hex-without-url-special-characters
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
NEXT_PRIVATE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=replace-with-openssl-rand-hex-32
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set true for implicit TLS on port 465; port 587 normally uses STARTTLS.
SMTP_SECURE=false
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=noreply@example.com
SIGNING_CERT_PASSWORD=replace-me
DISABLE_SIGNUP=false
